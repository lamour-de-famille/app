# Copier en .env et renseigner côté serveur uniquement. Aucune valeur ici.
# Origine publique de l'application (sert à l'URI de redirection OAuth).
APP_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=
# Secret de signature des sessions (32 caractères minimum, aléatoire).
SESSION_SECRET=
GEMINI_API_KEY=
# Modèle Gemini (vide = défaut de src/lib/ia/configuration.ts) et plafonds de dépense (vide = défauts prudents).
# Jetons de sortie = sortie + réflexion, plafonnés à part car plus chers.
GEMINI_MODEL=
IA_MAX_REQUETES_JOUR=
IA_MAX_JETONS_ENTREE_JOUR=
IA_MAX_JETONS_SORTIE_JOUR=
IA_MAX_REQUETES_MOIS=
IA_MAX_JETONS_ENTREE_MOIS=
IA_MAX_JETONS_SORTIE_MOIS=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Vacances scolaires (jeu ouvert, sans clé) : filtres facultatifs, vides = pas de filtre.
# Forme attendue : académie « Lyon », zone « Zone A », année « 2026-2027 ».
VACANCES_ACADEMIE=
VACANCES_ZONE=
VACANCES_ANNEE_SCOLAIRE=
# Firestore : identifiant du projet (côté serveur). Les identifiants viennent de l'environnement
# d'exécution (identité de la plateforme) ou de GOOGLE_APPLICATION_CREDENTIALS (chemin d'un fichier, jamais commité).
FIRESTORE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Émulateur local uniquement (ex. localhost:8080), laisser vide en production : sert à `npm run test:emulateur`.
FIRESTORE_EMULATOR_HOST=
